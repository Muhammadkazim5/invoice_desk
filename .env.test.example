# Used by `npm run test:e2e`. Points at a separate database so e2e tests
# never touch your development data. Create a matching .env.test locally
# (the test runner also works fine against the same docker-compose Postgres
# container as long as DB_NAME differs from your dev database).
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=invoice_desk_test

API_PORT=3001
WEB_ORIGIN=http://localhost:5173
